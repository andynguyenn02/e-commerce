server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Same-origin API: the upstream is injected at container start from
    # $API_UPSTREAM (see Dockerfile), so one image serves every environment.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routes (/cart, /orders/123) must all serve index.html.
    location / {
        try_files $uri /index.html;
    }

    # Hashed build assets never change; the HTML must always be revalidated.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
